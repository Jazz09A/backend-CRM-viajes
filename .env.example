# ── Driver de base de datos ──────────────────────────────────────────────
# sqlite  → desarrollo/pruebas (better-sqlite3, archivo local)
# postgres→ producción (DATABASE_URL)
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/dev.sqlite
DATABASE_URL=postgres://user:pass@localhost:5432/agencia_viajes

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:8080

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Seguridad / cifrado de datos (AES-256-GCM, base64 de 32 bytes) ───────
DATA_ENCRYPTION_KEY=
DATA_INDEX_HMAC_KEY=

# ── Storage de archivos (vouchers, exportaciones, comprobantes) ──────────
# local → archivos en disco en STORAGE_LOCAL_DIR (dev/tests)
# s3    → bucket S3-compatible privado con URLs firmadas (producción)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage

# S3-compatible (MinIO, AWS S3, etc.)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# URLs firmadas temporales (segundos)
SIGNED_URL_TTL_SECONDS=300

# URL pública de la app (para enlaces en emails/notificaciones)
PUBLIC_APP_URL=http://localhost:8080

# Origen público del propio API (URLs firmadas de archivos/vouchers);
# debe apuntar al API, no al frontend. Vacío → URL relativa mismo origen.
PUBLIC_API_URL=http://localhost:3001

# SameSite de la cookie de refresh: lax (mismo sitio) o none si el frontend
# vive en otro dominio (exige HTTPS/Secure).
COOKIE_SAMESITE=lax

# Secreto para firmar enlaces públicos HMAC
FILE_SIGNING_SECRET=dev-file-secret-cambiar

# ── Semilla de desarrollo ────────────────────────────────────────────────
# El administrador NO se crea por defecto: la primera vez se hace con el
# onboarding (POST /api/v1/setup/iniciar), que además personaliza la agencia.
#
# Estas variables son sólo para desarrollo/pruebas (se ignoran si
# NODE_ENV=production). Con las dos puestas se crea un superadmin al sembrar.
SEED_ADMIN_CORREO=
SEED_ADMIN_PASSWORD=

# Datos demo (usuarios, catálogo, fechas, tarifas). SEED_DEMO=false deja la
# base vacía: es lo que hay que usar para ver el onboarding en local.
SEED_DEMO=true
