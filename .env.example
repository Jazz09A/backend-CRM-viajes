# ── Driver de base de datos ──────────────────────────────────────────────
# sqlite  → desarrollo/pruebas (better-sqlite3, archivo local)
# postgres→ producción (DATABASE_URL)
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/dev.sqlite
DATABASE_URL="postgresql://usuario:password@ep-xxx.neon.tech:5432/neondb?sslmode=require"

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:8080

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=GENERAR-CON-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Seguridad / cifrado de datos (AES-256-GCM, base64 de 32 bytes) ───────
DATA_ENCRYPTION_KEY=GENERAR-CON-openssl-rand-base64-32
DATA_INDEX_HMAC_KEY=GENERAR-CON-openssl-rand-hex-32

# ── Almacenamiento de archivos (vouchers, comprobantes, firmas) ──────────
# local → desarrollo/pruebas (./data/storage, se pierde en cada redeploy)
# s3    → producción (bucket privado con URLs firmadas temporales)
#
# Para producción necesitas un bucket S3-compatible (AWS S3, Cloudflare R2,
# Backblaze B2, MinIO…). Rellena el bloque de abajo y despliega con
# STORAGE_DRIVER=s3:
#   S3_ENDPOINT      → p.ej. https://<cuenta>.r2.cloudflarestorage.com
#                      (déjalo vacío para AWS S3)
#   S3_REGION        → p.ej. us-east-1 (auto y R2 suelen ser us-east-1)
#   S3_BUCKET        → nombre del bucket, p.ej. ruta-clara-archivos
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY → par de claves del bucket
#   S3_FORCE_PATH_STYLE=true → obligatorio en R2/B2/MinIO
# La clave sólo debe dar permiso a ese bucket (no de cuenta completa).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ── URLs públicas ─────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:3001/api/v1

# ── SameSite de la cookie de refresh ───────────────────────────────────────
# lax (mismo sitio) o none (frontend y API en dominios distintos)
COOKIE_SAMESITE=lax

# ── Secreto para firmar enlaces públicos HMAC (comprobantes/vouchers) ──────
FILE_SIGNING_SECRET=GENERAR-CON-openssl-rand-base64-32

# ── Neon (opcional, solo si usas Neon Functions) ───────────────────────────
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
