# ──────────────────────────────────────────────────────────────────────────
# Producción — backend NestJS (Fase 4 del plan)
#
# Copiar a /opt/escapatetour/backend/.env y rellenar los placeholders.
# Generar secrets con:
#   openssl rand -base64 32   (JWT_SECRET, DATA_ENCRYPTION_KEY, FILE_SIGNING_SECRET)
#   openssl rand -hex 32      (DATA_INDEX_HMAC_KEY)
# ──────────────────────────────────────────────────────────────────────────

# ── Base de datos (Neon — pendiente hasta que llegue la rama) ─────────────
DB_DRIVER=postgres
DATABASE_URL=postgresql://usuario:PASSWORD@ep-xxx.neon.tech:5432/neondb?sslmode=require
DB_SQLITE_PATH=

# ── Servidor ──────────────────────────────────────────────────────────────
# El contenedor escucha en 8000 (docker-compose lo publica en 127.0.0.1:8100).
PORT=8000
CORS_ORIGINS=https://admin.escapatetour.app

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=GENERAR-CON-openssl-rand
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Cifrado de datos (AES-256-GCM, base64 de 32 bytes) ───────────────────
DATA_ENCRYPTION_KEY=GENERAR-CON-openssl-rand-base64-32
DATA_INDEX_HMAC_KEY=GENERAR-CON-openssl-rand-hex-32

# ── Storage (local con URLs firmadas; S3 queda para después) ─────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
SIGNED_URL_TTL_SECONDS=300

# ── URLs públicas ─────────────────────────────────────────────────────────
PUBLIC_APP_URL=https://admin.escapatetour.app
PUBLIC_API_URL=https://api.escapatetour.app

# Dominios distintos → none (exige Secure; nginx termina TLS en 443).
COOKIE_SAMESITE=none

# Secreto para firmar enlaces públicos HMAC (comprobantes/vouchers).
FILE_SIGNING_SECRET=GENERAR-CON-openssl-rand

# ── Semilla ───────────────────────────────────────────────────────────────
# En producción el admin se crea con el onboarding (POST /setup/iniciar);
# no sembrar superadmin ni datos demo.
SEED_ADMIN_CORREO=
SEED_ADMIN_PASSWORD=
SEED_DEMO=false
